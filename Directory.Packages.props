<Project>
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- transitive pin: Azure.Identity pulls a vulnerable 9.0.x (GHSA-846f-f764-76mx) -->
    <PackageVersion Include="ExcelDataReader" Version="3.9.0" />
    <PackageVersion Include="MimeKit" Version="5.0.0" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <!-- Cuts a picture into enlarged quarters for the diagram request. NoDependencies: the Linux native library needs no fontconfig in the image. -->
    <PackageVersion Include="SkiaSharp" Version="4.156.2" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.2" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <!-- The version Microsoft.Data.SqlClient already brings: sign-in methods validate ID tokens with it (one version in the app). -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="7.7.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- 6.2.4 is the last MIT release without a license check; 6.5+ needs a license key. -->
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
  </ItemGroup>
</Project>