[
  {
    "action": "space.list",
    "method": "GET",
    "path": "/api/v1/spaces",
    "expect": {"anonymous": 200, "outsider": 200, "reader": 200, "contributor": 200, "supervisor": 200, "owner": 200, "admin": 200},
    "scope": "server",
    "note": "Open to callers who are not signed in, for Anyone spaces only; this space is Private, so nothing is disclosed."
  },
  {
    "action": "space.read",
    "method": "GET",
    "path": "/api/v1/spaces/{space}",
    "expect": {"anonymous": 404, "outsider": 404, "reader": 200, "contributor": 200, "supervisor": 200, "owner": 200, "admin": 200},
    "sensitive": {"admin": 404},
    "note": "Open to callers who are not signed in, for Anyone spaces only; this space is Private, so nothing is disclosed."
  },
  {
    "action": "space.update",
    "method": "PATCH",
    "path": "/api/v1/spaces/{space}",
    "body": {"description": "Changed"},
    "expect": {"anonymous": 401, "outsider": 404, "reader": 403, "contributor": 403, "supervisor": 403, "owner": 200, "admin": 200},
    "sensitive": {"admin": 404}
  },
  {
    "action": "space.role.list",
    "method": "GET",
    "path": "/api/v1/spaces/{space}/roles",
    "expect": {"anonymous": 401, "outsider": 404, "reader": 403, "contributor": 403, "supervisor": 403, "owner": 200, "admin": 200},
    "sensitive": {"admin": 404}
  },
  {
    "action": "space.role.grant",
    "method": "PUT",
    "path": "/api/v1/spaces/{space}/roles",
    "body": {"principalType": "User", "principalId": "{newGuid}", "role": "Reader"},
    "expect": {"anonymous": 401, "outsider": 404, "reader": 403, "contributor": 403, "supervisor": 403, "owner": 204, "admin": 204},
    "sensitive": {"admin": 404}
  },
  {
    "action": "space.role.revoke",
    "method": "DELETE",
    "path": "/api/v1/spaces/{space}/roles/{assignment}",
    "expect": {"anonymous": 401, "outsider": 404, "reader": 403, "contributor": 403, "supervisor": 403, "owner": 204, "admin": 204},
    "sensitive": {"admin": 404}
  },
  {
    "action": "space.create",
    "method": "POST",
    "path": "/api/v1/spaces",
    "body": {"key": "{newKey}", "name": "Made by the matrix"},
    "expect": {"anonymous": 401, "outsider": 403, "reader": 403, "contributor": 403, "supervisor": 403, "owner": 403, "admin": 201},
    "scope": "server"
  },
  {
    "action": "space.list.all",
    "method": "GET",
    "path": "/api/v1/admin/spaces",
    "expect": {"anonymous": 401, "outsider": 403, "reader": 403, "contributor": 403, "supervisor": 403, "owner": 403, "admin": 200},
    "scope": "server"
  },
  {
    "action": "space.update.admin",
    "method": "PATCH",
    "path": "/api/v1/admin/spaces/{space}",
    "body": {},
    "expect": {"anonymous": 401, "outsider": 403, "reader": 403, "contributor": 403, "supervisor": 403, "owner": 403, "admin": 200},
    "scope": "space"
  },
  {
    "action": "space.delete",
    "method": "POST",
    "path": "/api/v1/admin/spaces/{spareSpace}/delete",
    "body": {"confirm": "{spareSpacePhrase}"},
    "expect": {"anonymous": 401, "outsider": 403, "reader": 403, "contributor": 403, "supervisor": 403, "owner": 403, "admin": 204},
    "scope": "server",
    "note": "A space made for this one request is deleted. Everyone but an Admin is refused before the phrase is looked at."
  },
  {
    "action": "space.restore",
    "method": "POST",
    "path": "/api/v1/admin/spaces/{deletedSpace}/restore",
    "expect": {"anonymous": 401, "outsider": 403, "reader": 403, "contributor": 403, "supervisor": 403, "owner": 403, "admin": 200},
    "scope": "server"
  },
  {
    "action": "space.list.deleted",
    "method": "GET",
    "path": "/api/v1/admin/spaces/deleted",
    "expect": {"anonymous": 401, "outsider": 403, "reader": 403, "contributor": 403, "supervisor": 403, "owner": 403, "admin": 200},
    "scope": "server"
  }
]
