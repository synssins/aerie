    "expect": {"anonymous": 401, "outsider": 404, "reader": 403, "contributor": 404, "supervisor": 404, "owner": 404, "admin": 404},
    "sensitive": {"admin": 404},
    "note": "No draft exists, so a caller who may have one gets 404; a Reader may not have one and gets 403."
