    "expect": {"anonymous": 401, "outsider": 404, "reader": "allowed", "contributor": "allowed", "supervisor": "allowed", "owner": "allowed", "admin": "allowed"},
    "sensitive": {"admin": 404}
  },
  {
    "action": "comment.edit",
    "method": "PUT",
    "path": "/api/v1/comments/{comment}",
    "body": {"text": "Changed"},
    "expect": {"anonymous": 401, "outsider": 404, "reader": 403, "contributor": 403, "supervisor": 403, "owner": 403, "admin": 403},
    "sensitive": {"admin": 404},
    "note": "Only the author edits; moderators hide or delete instead (question Q-0023)."
  },
  {
    "action": "comment.delete",
    "method": "DELETE",
    "path": "/api/v1/comments/{comment}",
    "expect": {"anonymous": 401, "outsider": 404, "reader": 403, "contributor": 403, "supervisor": "allowed", "owner": "allowed", "admin": 403},
    "sensitive": {"admin": 404},
    "note": "The author, or a Supervisor or Owner of the space; an Admin without a held role is not enough (question Q-0024)."
  },
  {
    "action": "comment.hide",
    "method": "POST",
    "path": "/api/v1/comments/{comment}/hide",
    "expect": {"anonymous": 401, "outsider": 404, "reader": 403, "contributor": 403, "supervisor": "allowed", "owner": "allowed", "admin": 403},
    "sensitive": {"admin": 404},
    "note": "Supervisors and Owners of the space (question Q-0024)."
  },
  {
    "action": "comment.restore",
    "method": "POST",
    "path": "/api/v1/comments/{comment}/restore",
    "expect": {"anonymous": 401, "outsider": 404, "reader": 403, "contributor": 403, "supervisor": 409, "owner": 409, "admin": 403},
    "sensitive": {"admin": 404},
    "note": "Supervisors and Owners of the space; the comment made for the matrix is visible, so restoring it is 409."
