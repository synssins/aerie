[
  {
    "action": "setup.status",
    "method": "GET",
    "path": "/api/v1/setup/status",
    "expect": {"anonymous": 200, "outsider": 200, "reader": 200, "contributor": 200, "supervisor": 200, "owner": 200, "admin": 200},
    "scope": "server"
  },
  {
    "action": "setup.run",
    "method": "POST",
    "path": "/api/v1/setup",
    "body": {},
    "expect": {"anonymous": "allowed", "outsider": "allowed", "reader": "allowed", "contributor": "allowed", "supervisor": "allowed", "owner": "allowed", "admin": "allowed"},
    "scope": "server"
  },
  {
    "action": "auth.signin",
    "method": "POST",
    "path": "/api/v1/auth/local/signin",
    "body": {},
    "expect": {"anonymous": 401, "outsider": 401, "reader": 401, "contributor": 401, "supervisor": 401, "owner": 401, "admin": 401},
    "scope": "server",
    "note": "No name and no password: the sign-in fails (401), whoever sends it. A session the caller already has plays no part."
  },
  {
    "action": "auth.signout",
    "method": "POST",
    "path": "/api/v1/auth/signout",
    "expect": {"anonymous": 401, "outsider": 204, "reader": 204, "contributor": 204, "supervisor": 204, "owner": 204, "admin": 204},
    "scope": "server",
    "freshSession": true
  },
  {
    "action": "me.read",
    "method": "GET",
    "path": "/api/v1/me",
    "expect": {"anonymous": 401, "outsider": 200, "reader": 200, "contributor": 200, "supervisor": 200, "owner": 200, "admin": 200},
    "scope": "server"
  },
  {
    "action": "me.settings.read",
    "method": "GET",
    "path": "/api/v1/me/settings",
    "expect": {"anonymous": 401, "outsider": 200, "reader": 200, "contributor": 200, "supervisor": 200, "owner": 200, "admin": 200},
    "scope": "server"
  },
  {
    "action": "me.settings.save",
    "method": "PUT",
    "path": "/api/v1/me/settings",
    "body": {},
    "expect": {"anonymous": 401, "outsider": "allowed", "reader": "allowed", "contributor": "allowed", "supervisor": "allowed", "owner": "allowed", "admin": "allowed"},
    "scope": "server"
  },
  {
    "action": "notification.list",
    "method": "GET",
    "path": "/api/v1/notifications",
    "expect": {"anonymous": 401, "outsider": 200, "reader": 200, "contributor": 200, "supervisor": 200, "owner": 200, "admin": 200},
    "scope": "server"
  },
  {
    "action": "notification.count",
    "method": "GET",
    "path": "/api/v1/notifications/count",
    "expect": {"anonymous": 401, "outsider": 200, "reader": 200, "contributor": 200, "supervisor": 200, "owner": 200, "admin": 200},
    "scope": "server"
  },
  {
    "action": "notification.mark.all",
    "method": "POST",
    "path": "/api/v1/notifications/read-all",
    "expect": {"anonymous": 401, "outsider": 204, "reader": 204, "contributor": 204, "supervisor": 204, "owner": 204, "admin": 204},
    "scope": "server"
  },
  {
    "action": "notification.mark",
    "method": "POST",
    "path": "/api/v1/notifications/{newGuid}/read",
    "expect": {"anonymous": 401, "outsider": 404, "reader": 404, "contributor": 404, "supervisor": 404, "owner": 404, "admin": 404},
    "scope": "server",
    "note": "Nobody has this notification, so everyone signed in gets 404."
  },
  {
    "action": "auth.local.disable",
    "method": "POST",
    "path": "/api/v1/admin/auth/local/disable",
    "expect": {"anonymous": 401, "outsider": 403, "reader": 403, "contributor": 403, "supervisor": 403, "owner": 403, "admin": 409},
    "scope": "server",
    "note": "409 for an Admin: no outside sign-in is verified, so local sign-in cannot be switched off."
  },
  {
    "action": "auth.password.set",
    "method": "POST",
    "path": "/api/v1/auth/local/password",
    "body": {"userId": "{newGuid}", "token": "not-a-link", "password": "a-long-enough-password-1"},
    "expect": {"anonymous": 400, "outsider": 400, "reader": 400, "contributor": 400, "supervisor": 400, "owner": 400, "admin": 400},
    "scope": "server",
    "note": "Setting a password needs the link an Admin handed over, not a session: a wrong link is refused the same way for everyone."
  }
]
