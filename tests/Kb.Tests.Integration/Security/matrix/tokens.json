[
  {
    "action": "token.list",
    "method": "GET",
    "path": "/api/v1/tokens",
    "expect": {"anonymous": 401, "outsider": 200, "reader": 200, "contributor": 200, "supervisor": 200, "owner": 200, "admin": 200},
    "scope": "server"
  },
  {
    "action": "token.create",
    "method": "POST",
    "path": "/api/v1/tokens",
    "body": {},
    "expect": {"anonymous": 401, "outsider": "allowed", "reader": "allowed", "contributor": "allowed", "supervisor": "allowed", "owner": "allowed", "admin": "allowed"},
    "scope": "server"
  },
  {
    "action": "token.revoke",
    "method": "DELETE",
    "path": "/api/v1/tokens/{token}",
    "expect": {"anonymous": 401, "outsider": 404, "reader": 404, "contributor": 404, "supervisor": 404, "owner": 204, "admin": 204},
    "scope": "server",
    "note": "The token is the Owner's personal one. It does not exist for anyone else, except an Admin."
  },
  {
    "action": "token.list.all",
    "method": "GET",
    "path": "/api/v1/admin/tokens",
    "expect": {"anonymous": 401, "outsider": 403, "reader": 403, "contributor": 403, "supervisor": 403, "owner": 403, "admin": 200},
    "scope": "server"
  },
  {
    "action": "token.settings.read",
    "method": "GET",
    "path": "/api/v1/admin/tokens/settings",
    "expect": {"anonymous": 401, "outsider": 403, "reader": 403, "contributor": 403, "supervisor": 403, "owner": 403, "admin": 200},
    "scope": "server"
  },
  {
    "action": "token.settings.save",
    "method": "PUT",
    "path": "/api/v1/admin/tokens/settings",
    "body": {},
    "expect": {"anonymous": 401, "outsider": 403, "reader": 403, "contributor": 403, "supervisor": 403, "owner": 403, "admin": "allowed"},
    "scope": "server"
  }
]
