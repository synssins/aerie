{
  "id": "kb.sample",
  "name": "Sample: acknowledgements",
  "version": "2.3.1",
  "publisher": "Kb first-party",
  "description": "Readers acknowledge a page. The reference plugin of the developer guide.",
  "assembly": "Kb.Plugin.Sample.dll",
  "minKbVersion": "0.7.0",
  "abstractionsVersion": "0.7.0",
  "extensionPoints": [],
  "outboundHosts": [],
  "settings": [
    {
      "key": "RequireNoteOnMajor",
      "label": "A major version needs a note",
      "type": "toggle"
    },
    {
      "key": "ResetOnMajor",
      "label": "A major version clears acknowledgements",
      "type": "toggle"
    },
    {
      "key": "KeepDays",
      "label": "Keep acknowledgements for",
      "type": "number",
      "unit": "days",
      "default": "365",
      "min": 0,
      "max": 3650,
      "help": "Older ones are deleted once a day. 0 deletes them all at the next run."
    }
  ],
  "schedules": [
    {
      "name": "purge",
      "everyMinutes": 1440
    }
  ],
  "permissions": [
    {
      "key": "see-acknowledgements",
      "label": "See who acknowledged a page",
      "scope": "space",
      "defaultRole": "Supervisor"
    }
  ],
  "uiApiVersion": "1.1.0",
  "ui": {
    "script": "ui/index.js"
  }
}
