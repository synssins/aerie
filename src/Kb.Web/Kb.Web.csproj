<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>kb-web-dev</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ExcelDataReader" />
    <PackageReference Include="MimeKit" />
    <PackageReference Include="PdfPig" />
    <ProjectReference Include="..\Kb.Core\Kb.Core.csproj" />
    <ProjectReference Include="..\Kb.Data\Kb.Data.csproj" />
    <ProjectReference Include="..\Kb.Data.Sqlite\Kb.Data.Sqlite.csproj" />
    <ProjectReference Include="..\..\plugins\Kb.Plugin.Email.Smtp\Kb.Plugin.Email.Smtp.csproj" />
    <ProjectReference Include="..\..\plugins\Kb.Plugin.Email.Graph\Kb.Plugin.Email.Graph.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="PDFsharp-MigraDoc" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Kb.Plugins" />
    <Using Include="Kb.Plugins.Actions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kb.Tests.Integration" />
  </ItemGroup>
  <ItemGroup>
    <!-- PDF export's fonts, inside the app; their license ships next to it. -->
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="Kb.Fonts.%(Filename).ttf" />
    <!-- The pinned compatible contract: the scope of each operation is read from it (DcScopes), so the table is never written by hand. -->
    <EmbeddedResource Include="..\..\contracts\datacenter\openapi.yaml" LogicalName="Kb.Contracts.datacenter-openapi.yaml" Link="Contracts\datacenter-openapi.yaml" />
    <None Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Fonts\OFL.txt" />
  </ItemGroup>
</Project>
