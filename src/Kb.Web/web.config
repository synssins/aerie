<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- The publish step adds the aspNetCore handler; this stops IIS naming itself in the Server header and lifts
           IIS's own 30,000,000-byte request limit to its maximum, so the app's limits are the ones that count: the
           attachment size set in Administration, and 30,000,000 bytes for every route that does not raise it itself. -->
      <security>
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="4294967295" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
